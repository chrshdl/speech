{
    "seed" : 2017,
    "save_path" : "examples/commonvoice/models/ctc_streaming_3750h_gpu",
    "mixed_precision" : "bf16",

    "data" : {
        "train_set" : [
            "examples/librispeech/data/LibriSpeech/train-clean-100.json",
            "examples/librispeech/data/LibriSpeech/train-clean-360.json",
            "examples/librispeech/data/LibriSpeech/train-other-500.json",
            "examples/commonvoice/data/train.json"
        ],
        "dev_set" : [
            "examples/librispeech/data/LibriSpeech/dev-clean.json",
            "examples/commonvoice/data/dev.json"
        ],
        "start_and_end" : false,
        "sortagrad" : true,
        "num_workers" : 16,
        "noise" : [
            {"p" : 0.3, "source" : "examples/noise/data", "snr" : [8, 16], "from_epoch" : 1},
            {
                "p" : 0.1,
                "source" : "examples/librispeech/data/LibriSpeech/train-clean-100.json",
                "layers" : [8, 12],
                "snr" : [8, 16],
                "from_epoch" : 1
            }
        ],
        "reverb" : {"p" : 0.2, "delay" : [2, 18], "decay" : [0.55, 0.85], "from_epoch" : 1},
        "volume" : {"p" : 0.2, "dbfs" : [-13, 7]},
        "pitch" : {"factor" : [0.9, 1.1]},
        "tempo" : {"factor" : [0.9, 1.1]},
        "spec_augment" : {
            "freq_masks" : 2,
            "freq_width" : 27,
            "time_masks" : 2,
            "time_width" : 40,
            "time_ratio" : 0.2
        }
    },

    "optimizer" : {
        "type" : "adam",
        "batch_size" : 32,
        "epochs" : 12,
        "learning_rate" : 2e-4,
        "lr_anneal" : 1.2
    },

    "model" : {
        "class" : "CTC",
        "dropout" : 0.2,
        "encoder" : {
            "conv" : [
                [32, 5, 41, 2],
                [32, 5, 21, 2]
            ],
            "rnn" : {
                "dim" : 1024,
                "bidirectional" : false,
                "layers" : 5
            },
            "lookahead" : 5,
            "batch_norm" : true,
            "relu_clip" : 20
        }
    }
}
