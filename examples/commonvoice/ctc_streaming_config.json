{
    "seed" : 2017,
    "save_path" : "examples/commonvoice/models/ctc_streaming",
    "mixed_precision" : "bf16",

    "data" : {
        "train_set" : [
            "examples/librispeech/data/LibriSpeech/train-clean-100.json",
            "examples/librispeech/data/LibriSpeech/train-clean-360.json",
            "examples/librispeech/data/LibriSpeech/train-other-500.json",
            "examples/commonvoice/data/train.json"
        ],
        "dev_set" : [
            "examples/librispeech/data/LibriSpeech/dev-clean.json",
            "examples/commonvoice/data/dev.json"
        ],
        "start_and_end" : false,
        "num_workers" : 16,
        "spec_augment" : {
            "freq_masks" : 2,
            "freq_width" : 27,
            "time_masks" : 2,
            "time_width" : 40,
            "time_ratio" : 0.2
        }
    },

    "optimizer" : {
        "type" : "adam",
        "batch_size" : 32,
        "epochs" : 12,
        "learning_rate" : 5e-4,
        "lr_decay" : {
            "factor" : 0.5,
            "patience" : 1,
            "min_lr" : 1e-5
        }
    },

    "model" : {
        "class" : "CTC",
        "dropout" : 0.2,
        "encoder" : {
            "conv" : [
                [32, 5, 41, 2],
                [32, 5, 21, 2]
            ],
            "rnn" : {
                "dim" : 1024,
                "bidirectional" : false,
                "layers" : 5
            },
            "lookahead" : 5
        }
    }
}
