{
    "seed" : 2017,
    "save_path" : "examples/librispeech/models/ctc_streaming",

    "data" : {
        "train_set" : "examples/librispeech/data/train.json",
        "dev_set" : "examples/librispeech/data/dev.json",
        "start_and_end" : false,
        "num_workers" : 1
    },

    "optimizer" : {
        "type" : "adam",
        "batch_size" : 8,
        "epochs" : 30,
        "learning_rate" : 5e-4
    },

    "model" : {
        "class" : "CTC",
        "dropout" : 0.2,
        "encoder" : {
            "conv" : [
                [32, 5, 41, 2],
                [32, 5, 21, 2]
            ],
            "rnn" : {
                "dim" : 384,
                "bidirectional" : false,
                "layers" : 3
            },
            "lookahead" : 5
        }
    }
}
